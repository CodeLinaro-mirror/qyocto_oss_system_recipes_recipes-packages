--- nftables-1.1.1.orig/src/netlink_delinearize.c
+++ nftables-1.1.1/src/netlink_delinearize.c
@@ -1356,6 +1356,57 @@ out_err:
 	stmt_free(stmt);
 }

+static void netlink_parse_npt(struct netlink_parse_ctx *ctx, const struct location *loc,
+				const struct nftnl_expr *nle)
+{
+	struct stmt *stmt;
+	struct expr *addr;
+	enum nft_registers reg1, reg2;
+	int family;
+
+	stmt = nat_stmt_alloc(loc, nftnl_expr_get_u32(nle, NFTNL_EXPR_NPT_TYPE));
+
+	family = nftnl_expr_get_u32(nle, NFTNL_EXPR_NPT_FAMILY);
+
+	if (ctx->table->handle.family != NFPROTO_IPV6)
+		goto out_err;
+
+	stmt->nat.family = family;
+
+	addr = NULL;
+	reg1 = netlink_parse_register(nle, NFTNL_EXPR_NPT_REG_SRC_PFX);
+	if (reg1) {
+		addr = netlink_get_register(ctx, loc, reg1);
+		if (addr == NULL) {
+			netlink_error(ctx, loc, "NPT statement has no address expression");
+			goto out_err;
+		}
+
+		expr_set_type(addr, &ip6addr_type, BYTEORDER_BIG_ENDIAN);
+		stmt->nat.src_pfx = addr;
+	}
+
+	reg2 = netlink_parse_register(nle, NFTNL_EXPR_NPT_REG_DST_PFX);
+	if (reg2) {
+		addr = netlink_get_register(ctx, loc, reg2);
+		if (addr == NULL) {
+			netlink_error(ctx, loc, "NPT statement has no address expression");
+			goto out_err;
+		}
+
+		expr_set_type(addr, &ip6addr_type, BYTEORDER_BIG_ENDIAN);
+		stmt->nat.dst_pfx = addr;
+	}
+
+	stmt->nat.src_pfx_len = nftnl_expr_get_u8(nle, NFTNL_EXPR_NPT_SRC_PFXLEN);
+	stmt->nat.dst_pfx_len = nftnl_expr_get_u8(nle, NFTNL_EXPR_NPT_DST_PFXLEN);
+
+	ctx->stmt = stmt;
+	return;
+out_err:
+	stmt_free(stmt);
+}
+
